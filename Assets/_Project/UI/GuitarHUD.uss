/* Root UI Layout */
.guitar-hud__root,
.chord-wheel__root {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    -unity-font: url("project://database/Assets/_Project/UI/BarlowCondensed-Regular.ttf");
    -unity-font-definition: url("project://database/Assets/_Project/UI/BarlowCondensed-Regular.ttf");
}

Label, Button {
    -unity-font: url("project://database/Assets/_Project/UI/BarlowCondensed-Regular.ttf");
    -unity-font-definition: url("project://database/Assets/_Project/UI/BarlowCondensed-Regular.ttf");
}

/* ========================================================================= */
/* Menu Button (Top-Left)                                                     */
/* ========================================================================= */

.hud-menu-btn {
    position: absolute;
    top: 24px;
    left: 24px;
    width: 72px;
    height: 72px;
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.14);
    border-radius: 16px;
    color: rgba(255, 255, 255, 0.85);
    font-size: 34px;
    -unity-text-align: middle-center;
    -unity-font: url("project://database/Assets/_Project/UI/BarlowCondensed-Regular.ttf");
    -unity-font-definition: url("project://database/Assets/_Project/UI/BarlowCondensed-Regular.ttf");
    transition-property: background-color, border-color;
    transition-duration: 150ms;
}

.hud-menu-btn:hover {
    background-color: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.25);
}

.hud-menu-btn:active {
    background-color: rgba(255, 255, 255, 0.24);
}

/* Hidden while electric mode is active — toggled by ElectricModeController */
.guitar-hud__root--hidden {
    display: none;
}

/* ========================================================================= */
/* Electric Mode Toggle (Top-Left, under the menu button)                     */
/* ========================================================================= */

.hud-amp-btn {
    position: absolute;
    top: 110px;
    left: 24px;
    width: 72px;
    height: 72px;
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.14);
    border-radius: 16px;
    color: rgba(255, 255, 255, 0.85);
    font-size: 24px;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    -unity-font: url("project://database/Assets/_Project/UI/BarlowCondensed-Regular.ttf");
    -unity-font-definition: url("project://database/Assets/_Project/UI/BarlowCondensed-Regular.ttf");
    transition-property: background-color, border-color;
    transition-duration: 150ms;
}

.hud-amp-btn:hover {
    background-color: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.25);
}

.hud-amp-btn:active {
    background-color: rgba(255, 255, 255, 0.24);
}

/* ========================================================================= */
/* Capo Controls (Top-Center)                                                */
/* ========================================================================= */


.capo-container {
    position: absolute;
    top: 38px;
    left: 0;
    right: 0;
    align-items: center;
}

.capo-header {
    font-size: 28px;
    -unity-font-style: bold;
    color: #9aa4b2ff;
    letter-spacing: 2px;
    margin-bottom: 6px;
    -unity-text-align: middle-center;
}

.capo-pill {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 68px;
    flex-shrink: 0;
    padding-left: 8px;
    padding-right: 8px;
    background-color: rgba(14, 17, 22, 0.88);
    border-radius: 14px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-top-color: rgba(255, 255, 255, 0.22);
}

.capo-btn {
    width: 64px;
    height: 58px;
    min-width: 64px;
    max-width: 64px;
    min-height: 58px;
    max-height: 58px;
    flex-shrink: 0;
    border-radius: 11px;
    background-color: rgba(28, 32, 40, 0.95);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.06);
    border-top-color: rgba(255, 255, 255, 0.16);
    color: #B8C2CC;
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
    transition-property: background-color, scale, border-color;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.capo-btn:hover {
    background-color: rgba(44, 50, 62, 0.95);
    border-color: rgba(212, 162, 68, 0.40);
    color: #FFFFFF;
}

.capo-btn:active {
    background-color: rgba(64, 50, 24, 0.95);
    border-color: rgba(240, 184, 66, 0.80);
    scale: 0.94 0.94;
    color: #FFE694;
}

.capo-btn--disabled {
    opacity: 0.30;
}

.capo-value {
    width: 80px;
    min-width: 80px;
    max-width: 80px;
    height: 58px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
    font-size: 32px;
    -unity-font-style: bold;
    color: #F0F2F5;
    padding-left: 8px;
    padding-right: 8px;
    letter-spacing: 0.5px;
    margin: 0;
}

/* ========================================================================= */
/* Key Selection HUD (Middle-Left)                                           */
/* ========================================================================= */

.key-selection-container {
    position: absolute;
    left: 62px;
    bottom: 530px;
    width: 360px;
    align-items: center;
}

.key-root-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 280px;
    margin-bottom: 14px;
}

.key-arrow-btn {
    width: 56px;
    height: 56px;
    min-width: 56px;
    max-width: 56px;
    min-height: 56px;
    max-height: 56px;
    flex-shrink: 0;
    border-radius: 12px;
    background-color: rgba(28, 32, 40, 0.95);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-top-color: rgba(255, 255, 255, 0.20);
    color: #CED5DE;
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
    transition-property: background-color, scale, border-color, color;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.key-arrow-btn:hover {
    background-color: rgba(44, 50, 62, 0.95);
    border-color: rgba(212, 162, 68, 0.40);
    color: #FFFFFF;
}

.key-arrow-btn:active {
    background-color: rgba(64, 50, 24, 0.95);
    border-color: rgba(240, 184, 66, 0.80);
    scale: 0.94 0.94;
    color: #FFE694;
}

.key-root-label {
    width: 100px;
    min-width: 100px;
    max-width: 100px;
    height: 56px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
    font-size: 36px;
    -unity-font-style: bold;
    color: #F0F2F5;
    letter-spacing: 1px;
    margin: 0;
}

.key-mode-container {
    position: relative;
    flex-direction: row;
    align-items: center;
    width: 240px;
    height: 54px;
    background-color: rgba(14, 17, 22, 0.92);
    border-radius: 27px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-top-color: rgba(255, 255, 255, 0.20);
    padding: 4px;
}

.key-mode-thumb {
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: 4px;
    width: 114px;
    background-color: rgba(212, 162, 68, 0.22);
    border-width: 1px;
    border-color: rgba(240, 184, 66, 0.65);
    border-radius: 23px;
    transition-property: left, background-color, border-color;
    transition-duration: 0.20s;
    transition-timing-function: ease-out;
}

.key-mode-thumb--minor {
    left: 119px;
}

.key-mode-btn {
    flex-grow: 1;
    height: 44px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: #8A96A6;
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-radius: 23px;
    margin: 0;
    padding: 0;
    transition-property: color;
    transition-duration: 0.15s;
}

.key-mode-btn:hover {
    color: #FFFFFF;
}

.key-mode-btn--active {
    color: #FFE694;
    font-size: 19px;
}

/* ========================================================================= */
/* Chord Shape Selector (Bottom-Left)                                       */
/* ========================================================================= */

.shape-selector-container {
    position: absolute;
    left: 62px;
    bottom: 44px;
    width: 360px;
    height: 440px;
    align-items: center;
}

.shape-selector-header {
    height: 34px;
    font-size: 22px;
    -unity-font-style: bold;
    color: #F0F2F5;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
}

.shape-selector-marker {
    position: absolute;
    top: 28px;
    left: 0;
    right: 0;
    align-items: center;
}

.shape-selector-marker > Label {
    color: #FFE694;
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.shape-selector-dial {
    width: 360px;
    height: 360px;
    margin-top: 2px;
}

.shape-selector-degree {
    position: absolute;
    width: 48px;
    height: 48px;
    font-size: 34px;
    -unity-font-style: bold;
    color: #F0F2F5;
    -unity-text-align: middle-center;
}

.shape-selector-degree--active {
    color: #FFE694;
    font-size: 37px;
}

.shape-selector-thumb {
    position: absolute;
    width: 64px;
    height: 64px;
    border-radius: 32px;
    background-color: rgba(53, 57, 65, 0.98);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.34);
    border-top-color: rgba(255, 255, 255, 0.52);
    transition-property: left, top;
    transition-duration: 0.06s;
    transition-timing-function: ease-out;
}

.shape-selector-hint {
    margin-top: 8px;
    font-size: 15px;
    color: #C1C8D0;
    -unity-text-align: middle-center;
}

/* ========================================================================= */
/* Chord Wheel HUD (Right Side)                                              */
/* ========================================================================= */

.chord-wheel__container {
    width: 380px;
    height: 380px;
    position: absolute;
    top: 50px;
    right: 100px;
}

.chord-wheel__header {
    position: absolute;
    top: -30px;
    right: 20px;
    flex-direction: row;
    align-items: center;
}

.chord-wheel__header-prefix {
    font-size: 20px;
    -unity-font-style: bold;
    color: #9AA4B2;
    letter-spacing: 1px;
}

.chord-wheel__header-name {
    font-size: 20px;
    -unity-font-style: bold;
    color: #F0B842;
    letter-spacing: 0.5px;
}

.chord-sector {
    position: absolute;
    top: 0;
    left: 0;
    width: 380px;
    height: 380px;
    transform-origin: 190px 190px;
    transition-property: scale;
    transition-duration: 0.18s;
    transition-timing-function: ease-out;
    scale: 1 1;
}

.chord-sector--active {
    scale: 1.08 1.08;
}

.chord-wheel__hub {
    width: 140px;
    height: 140px;
    border-radius: 70px;
    background-color: rgba(14, 17, 24, 0.96);
    border-width: 2px;
    border-color: rgba(212, 162, 68, 0.45);
    position: absolute;
    left: 120px;
    top: 120px;
    align-items: center;
    justify-content: center;
}

.chord-wheel__hub-divider {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 12px;
}

.chord-wheel__hub-line {
    flex-grow: 1;
    height: 1px;
    background-color: rgba(212, 162, 68, 0.55);
}

.chord-wheel__hub-ring {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    border-width: 1.5px;
    border-color: rgba(212, 162, 68, 0.85);
    margin-left: 4px;
    margin-right: 4px;
}

.chord-sector__label-box {
    position: absolute;
    align-items: center;
    justify-content: center;
    width: 70px;
    height: 54px;
    margin-left: -35px;
    margin-top: -27px;
}

.chord-sector__roman {
    font-size: 20px;
    -unity-font-style: bold;
    color: #D8B266;
    margin-bottom: 2px;
    -unity-text-align: middle-center;
}

.chord-sector__roman--minor {
    color: #8AAAC6;
}

.chord-sector__roman--active {
    color: #FFE694;
}

.chord-sector__name {
    font-size: 30px;
    -unity-font-style: bold;
    color: #F0F2F5;
    -unity-text-align: middle-center;
}

.chord-sector__name--active {
    color: #FFFFFF;
    font-size: 32px;
}

/* ========================================================================= */
/* Guitar String Panel (Bottom-Right)                                        */
/* ========================================================================= */

.string-panel-container {
    position: absolute;
    right: 80px;
    top: 440px;
    bottom: 44px;
    width: 720px;
    flex-direction: column;
    padding-top: 18px;
    padding-bottom: 18px;
    padding-left: 20px;
    padding-right: 24px;
    background-color: rgba(14, 17, 22, 0.55);
    border-radius: 18px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-top-color: rgba(255, 255, 255, 0.20);
}

.guitar-string__label {
    position: absolute;
    left: 8px;
    top: 0;
    bottom: 0;
    width: 32px;
    -unity-text-align: middle-center;
    font-size: 24px;
    -unity-font-style: bold;
    color: #9AA4B2;
}

/* ========================================================================= */
/* Touch Tracer Overlay (Fullscreen)                                         */
/* ========================================================================= */

.touch-tracer-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}
