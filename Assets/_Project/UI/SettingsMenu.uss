/* =========================================================================== */
/* Settings Menu Stylesheet                                                      */
/* Dark theme, Barlow Condensed font — matches GuitarHUD aesthetic               */
/* =========================================================================== */

/* Full-screen container holding the scrim and the left column */
.settings-root {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

/* Gray translucent backdrop — fades in when the panel opens */
.settings-scrim {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.5);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 300ms;
    transition-timing-function: ease-out;
}

.settings-scrim--open {
    opacity: 1;
}

/* Left column panel — slides in from off-screen left */
.settings-panel {
    position: absolute;
    top: 0;
    left: 0;
    width: 42%;
    min-width: 320px;
    max-width: 560px;
    height: 100%;
    background-color: #080b12;
    flex-direction: column;
    translate: -100% 0;
    transition-property: translate;
    transition-duration: 300ms;
    transition-timing-function: ease-out;
    -unity-font: url("project://database/Assets/_Project/UI/BarlowCondensed-Regular.ttf");
    -unity-font-definition: url("project://database/Assets/_Project/UI/BarlowCondensed-Regular.ttf");
}

/* Slide in — controller toggles this class */
.settings-panel--open {
    translate: 0 0;
}

/* =========================================================================== */
/* Header Bar                                                                    */
/* =========================================================================== */

.settings-header-bar {
    flex-direction: row;
    align-items: center;
    padding-top: 24px;
    padding-bottom: 20px;
    padding-left: 24px;
    padding-right: 24px;
    border-bottom-width: 1.5px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
    background-color: #0c1018;
}

.settings-close-btn {
    width: 72px;
    height: 72px;
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.14);
    border-radius: 16px;
    color: rgba(255, 255, 255, 0.85);
    font-size: 44px;
    -unity-text-align: middle-center;
    margin-right: 20px;
    -unity-font: url("project://database/Assets/_Project/UI/BarlowCondensed-Regular.ttf");
    -unity-font-definition: url("project://database/Assets/_Project/UI/BarlowCondensed-Regular.ttf");
    transition-property: background-color, border-color;
    transition-duration: 150ms;
}

.settings-close-btn:hover {
    background-color: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.25);
}

.settings-close-btn:active {
    background-color: rgba(255, 255, 255, 0.24);
}

.settings-title {
    font-size: 30px;
    color: rgba(255, 255, 255, 0.55);
    letter-spacing: 5px;
    -unity-text-align: middle-left;
    -unity-font: url("project://database/Assets/_Project/UI/BarlowCondensed-Regular.ttf");
    -unity-font-definition: url("project://database/Assets/_Project/UI/BarlowCondensed-Regular.ttf");
}

/* =========================================================================== */
/* Scroll Area                                                                   */
/* =========================================================================== */

.settings-scroll {
    flex-grow: 1;
    padding-top: 12px;
    padding-bottom: 40px;
}

/* =========================================================================== */
/* Section Group                                                                 */
/* =========================================================================== */

.settings-section {
    flex-direction: column;
    padding-left: 36px;
    padding-right: 36px;
    padding-top: 24px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.06);
}

.settings-section__header {
    font-size: 42px;
    color: #F0B842;
    letter-spacing: 1.5px;
    margin-bottom: 10px;
    -unity-text-align: middle-left;
    -unity-font: url("project://database/Assets/_Project/UI/BarlowCondensed-Regular.ttf");
    -unity-font-definition: url("project://database/Assets/_Project/UI/BarlowCondensed-Regular.ttf");
}

.settings-section__items {
    flex-direction: column;
    padding-bottom: 16px;
}

/* Single tappable settings option — no destination yet, tap feedback only */
.settings-item {
    height: 64px;
    background-color: transparent;
    border-width: 0;
    border-radius: 10px;
    color: rgba(255, 255, 255, 0.45);
    font-size: 22px;
    letter-spacing: 0.8px;
    -unity-text-align: middle-left;
    padding-left: 16px;
    margin-bottom: 4px;
    -unity-font: url("project://database/Assets/_Project/UI/BarlowCondensed-Regular.ttf");
    -unity-font-definition: url("project://database/Assets/_Project/UI/BarlowCondensed-Regular.ttf");
    transition-property: background-color, color;
    transition-duration: 120ms;
}

.settings-item:hover {
    background-color: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.75);
}

.settings-item:active {
    background-color: rgba(255, 255, 255, 0.18);
    color: rgba(255, 255, 255, 0.95);
}
