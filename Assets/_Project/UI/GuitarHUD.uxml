<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <Style src="project://database/Assets/_Project/UI/GuitarHUD.uss?fileID=7433441132597879392&amp;guid=6884464e06f37164baf0cd1178189864&amp;type=3#GuitarHUD" />
    <ui:VisualElement name="guitar-hud-root" class="guitar-hud__root" picking-mode="Ignore">
        <!-- Top-Left Menu Button -->
        <ui:Button name="hud-menu-btn" class="hud-menu-btn" text="&#x2630;" />
        <!-- Top-Left Electric Mode Toggle -->
        <ui:Button name="amp-mode-btn" class="hud-amp-btn" text="AMP" focusable="false" />
        <!-- Top-Center Capo Controls -->
        <ui:VisualElement name="capo-container" class="capo-container" picking-mode="Ignore">

            <ui:Label name="capo-header" class="capo-header" text="CAPO" picking-mode="Ignore" />
            <ui:VisualElement name="capo-pill" class="capo-pill" picking-mode="Ignore">
                <ui:Button name="capo-decrement-btn" class="capo-btn capo-btn--left" text="−" />
                <ui:Label name="capo-value-label" class="capo-value" text="0" picking-mode="Ignore" />
                <ui:Button name="capo-increment-btn" class="capo-btn capo-btn--right" text="+" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Middle-Left Key Selection HUD -->
        <ui:VisualElement name="key-selection-container" class="key-selection-container" picking-mode="Ignore">
            <!-- Root Key Row: Left Arrow, Root Letter, Right Arrow -->
            <ui:VisualElement name="key-root-row" class="key-root-row" picking-mode="Ignore">
                <ui:Button name="key-prev-btn" class="key-arrow-btn key-arrow-btn--left" text="‹" />
                <ui:Label name="key-root-label" class="key-root-label" text="C" picking-mode="Ignore" />
                <ui:Button name="key-next-btn" class="key-arrow-btn key-arrow-btn--right" text="›" />
            </ui:VisualElement>

            <!-- Mode Toggle Switch: Major / Minor -->
            <ui:VisualElement name="key-mode-container" class="key-mode-container" picking-mode="Ignore">
                <ui:VisualElement name="key-mode-thumb" class="key-mode-thumb" picking-mode="Ignore" />
                <ui:Button name="key-mode-major-btn" class="key-mode-btn key-mode-btn--major key-mode-btn--active" text="Major" />
                <ui:Button name="key-mode-minor-btn" class="key-mode-btn key-mode-btn--minor" text="Minor" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Bottom-Left Chord Shape Selector -->
        <ui:VisualElement name="shape-selector-container" class="shape-selector-container" picking-mode="Ignore">
            <ui:Label name="shape-selector-header" class="shape-selector-header" text="CHORD SHAPE" picking-mode="Ignore" />
            <ui:VisualElement name="shape-selector-marker" class="shape-selector-marker" picking-mode="Ignore">
                <ui:Label text="▲" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="shape-selector-dial" class="shape-selector-dial">
                <ui:Label name="shape-degree-0" class="shape-selector-degree" text="1" picking-mode="Ignore" />
                <ui:Label name="shape-degree-1" class="shape-selector-degree" text="5" picking-mode="Ignore" />
                <ui:Label name="shape-degree-2" class="shape-selector-degree" text="2" picking-mode="Ignore" />
                <ui:Label name="shape-degree-3" class="shape-selector-degree" text="6" picking-mode="Ignore" />
                <ui:Label name="shape-degree-4" class="shape-selector-degree" text="3" picking-mode="Ignore" />
                <ui:Label name="shape-degree-5" class="shape-selector-degree" text="4" picking-mode="Ignore" />
                <ui:VisualElement name="shape-selector-thumb" class="shape-selector-thumb" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label class="shape-selector-hint" text="Use joystick to change shape" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- Right Side Chord Wheel -->
        <ui:VisualElement name="chord-wheel-container" class="chord-wheel__container" picking-mode="Ignore">
            <!-- Header Key Indicator -->
            <ui:VisualElement name="chord-wheel-header" class="chord-wheel__header" picking-mode="Ignore">
                <ui:Label class="chord-wheel__header-prefix" text="KEY: " picking-mode="Ignore" />
                <ui:Label name="chord-wheel-key-name" class="chord-wheel__header-name" text="C Major" picking-mode="Ignore" />
            </ui:VisualElement>

            <!-- 6 Absolute Sectors: 0=IV, 1=I, 2=V, 3=iii, 4=vi, 5=ii -->
            <ui:VisualElement name="sector-0" class="chord-sector" picking-mode="Ignore">
                <ui:VisualElement name="label-box-0" class="chord-sector__label-box" picking-mode="Ignore">
                    <ui:Label name="roman-0" class="chord-sector__roman" text="IV" picking-mode="Ignore" />
                    <ui:Label name="name-0" class="chord-sector__name" text="F" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="sector-1" class="chord-sector chord-sector--active" picking-mode="Ignore">
                <ui:VisualElement name="label-box-1" class="chord-sector__label-box" picking-mode="Ignore">
                    <ui:Label name="roman-1" class="chord-sector__roman chord-sector__roman--active" text="I" picking-mode="Ignore" />
                    <ui:Label name="name-1" class="chord-sector__name chord-sector__name--active" text="C" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="sector-2" class="chord-sector" picking-mode="Ignore">
                <ui:VisualElement name="label-box-2" class="chord-sector__label-box" picking-mode="Ignore">
                    <ui:Label name="roman-2" class="chord-sector__roman" text="V" picking-mode="Ignore" />
                    <ui:Label name="name-2" class="chord-sector__name" text="G" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="sector-3" class="chord-sector" picking-mode="Ignore">
                <ui:VisualElement name="label-box-3" class="chord-sector__label-box" picking-mode="Ignore">
                    <ui:Label name="roman-3" class="chord-sector__roman chord-sector__roman--minor" text="iii" picking-mode="Ignore" />
                    <ui:Label name="name-3" class="chord-sector__name" text="Em" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="sector-4" class="chord-sector" picking-mode="Ignore">
                <ui:VisualElement name="label-box-4" class="chord-sector__label-box" picking-mode="Ignore">
                    <ui:Label name="roman-4" class="chord-sector__roman chord-sector__roman--minor" text="vi" picking-mode="Ignore" />
                    <ui:Label name="name-4" class="chord-sector__name" text="Am" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="sector-5" class="chord-sector" picking-mode="Ignore">
                <ui:VisualElement name="label-box-5" class="chord-sector__label-box" picking-mode="Ignore">
                    <ui:Label name="roman-5" class="chord-sector__roman chord-sector__roman--minor" text="ii" picking-mode="Ignore" />
                    <ui:Label name="name-5" class="chord-sector__name" text="Dm" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Center Hub (centered at 190, 190) -->
            <ui:VisualElement name="chord-wheel-hub" class="chord-wheel__hub" picking-mode="Ignore">
                <ui:VisualElement class="chord-wheel__hub-divider" picking-mode="Ignore">
                    <ui:VisualElement class="chord-wheel__hub-line" picking-mode="Ignore" />
                    <ui:VisualElement class="chord-wheel__hub-ring" picking-mode="Ignore" />
                    <ui:VisualElement class="chord-wheel__hub-line" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Bottom-Right Guitar Strings -->
        <ui:VisualElement name="string-panel-container" class="string-panel-container" picking-mode="Ignore" />

        <!-- Fullscreen Touch Tracer Overlay -->
        <ui:VisualElement name="touch-tracer-overlay" class="touch-tracer-overlay" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
