<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="SettingsMenu.uss" />
    <ui:VisualElement name="settings-root" class="settings-root" picking-mode="Ignore">

        <!-- Gray translucent backdrop — clicking it closes the menu -->
        <ui:VisualElement name="settings-scrim" class="settings-scrim" picking-mode="Ignore" />

        <!-- Left column panel -->
        <ui:VisualElement name="settings-panel" class="settings-panel" picking-mode="Ignore">

            <!-- Header Bar -->
            <ui:VisualElement name="settings-header-bar" class="settings-header-bar" picking-mode="Ignore">
                <ui:Button name="settings-close-btn" class="settings-close-btn" text="&#x2039;" />
                <ui:Label class="settings-title" text="SETTINGS" picking-mode="Ignore" />
            </ui:VisualElement>

            <!-- Scrollable Content -->
            <ui:ScrollView name="settings-scroll" class="settings-scroll">

                <!-- Guitar Setup -->
                <ui:VisualElement class="settings-section">
                    <ui:Label class="settings-section__header" text="Guitar Setup" picking-mode="Ignore" />
                    <ui:VisualElement class="settings-section__items" picking-mode="Ignore">
                        <ui:Button class="settings-item" text="Tuning" focusable="false" />
                        <ui:Button class="settings-item" text="Volume" focusable="false" />
                        <ui:Button class="settings-item" text="Electric mode" focusable="false" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Chord Studio -->
                <ui:VisualElement class="settings-section">
                    <ui:Label class="settings-section__header" text="Chord Studio" picking-mode="Ignore" />
                    <ui:VisualElement class="settings-section__items" picking-mode="Ignore">
                        <ui:Button name="settings-item-chord-maker" class="settings-item" text="Chord maker" focusable="false" />
                        <ui:Button class="settings-item" text="Wheel maker" focusable="false" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Song Library -->
                <ui:VisualElement class="settings-section">
                    <ui:Label class="settings-section__header" text="Song Library" picking-mode="Ignore" />
                    <ui:VisualElement class="settings-section__items" picking-mode="Ignore">
                        <ui:Button class="settings-item" text="Songs" focusable="false" />
                        <ui:Button class="settings-item" text="Search" focusable="false" />
                        <ui:Button class="settings-item" text="Saved songs" focusable="false" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Customization -->
                <ui:VisualElement class="settings-section">
                    <ui:Label class="settings-section__header" text="Customization" picking-mode="Ignore" />
                    <ui:VisualElement class="settings-section__items" picking-mode="Ignore">
                        <ui:Button class="settings-item" text="Guitar" focusable="false" />
                        <ui:Button class="settings-item" text="Character" focusable="false" />
                        <ui:Button class="settings-item" text="Room" focusable="false" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Gem Store -->
                <ui:VisualElement class="settings-section">
                    <ui:Label class="settings-section__header" text="Gem Store" picking-mode="Ignore" />
                    <ui:VisualElement class="settings-section__items" picking-mode="Ignore">
                        <ui:Button class="settings-item" text="Buy gems" focusable="false" />
                        <ui:Button class="settings-item" text="Cosmetic unlocks" focusable="false" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Controls & Display -->
                <ui:VisualElement class="settings-section">
                    <ui:Label class="settings-section__header" text="Controls &amp; Display" picking-mode="Ignore" />
                    <ui:VisualElement class="settings-section__items" picking-mode="Ignore">
                        <ui:Button class="settings-item" text="Left-handed mode" focusable="false" />
                        <ui:Button class="settings-item" text="PC keybinds" focusable="false" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Account -->
                <ui:VisualElement class="settings-section">
                    <ui:Label class="settings-section__header" text="Account" picking-mode="Ignore" />
                    <ui:VisualElement class="settings-section__items" picking-mode="Ignore">
                        <ui:Button class="settings-item" text="Sign in" focusable="false" />
                        <ui:Button class="settings-item" text="Sign out" focusable="false" />
                        <ui:Button class="settings-item" text="Cloud saves" focusable="false" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Preferences -->
                <ui:VisualElement class="settings-section">
                    <ui:Label class="settings-section__header" text="Preferences" picking-mode="Ignore" />
                    <ui:VisualElement class="settings-section__items" picking-mode="Ignore">
                        <ui:Button class="settings-item" text="Audio" focusable="false" />
                        <ui:Button class="settings-item" text="Gameplay" focusable="false" />
                        <ui:Button class="settings-item" text="Accessibility" focusable="false" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- About & Support -->
                <ui:VisualElement class="settings-section">
                    <ui:Label class="settings-section__header" text="About &amp; Support" picking-mode="Ignore" />
                    <ui:VisualElement class="settings-section__items" picking-mode="Ignore">
                        <ui:Button class="settings-item" text="Website" focusable="false" />
                        <ui:Button class="settings-item" text="Help" focusable="false" />
                        <ui:Button class="settings-item" text="Credits" focusable="false" />
                    </ui:VisualElement>
                </ui:VisualElement>

            </ui:ScrollView>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
